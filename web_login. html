 <!doctype html><html lang="hi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Ads Rewards</title>
<style>
:root{--bg:#f6f7f9;--card:#fff;--tx:#14171f;--mut:#667085;--ac:#2563eb;--bd:#e4e7ec;color-scheme:light}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#0f1218;--card:#1a1f29;--tx:#eef0f4;--mut:#9aa3b2;--ac:#6ea0ff;--bd:#2a3140;color-scheme:dark}}
:root[data-theme=dark]{--bg:#0f1218;--card:#1a1f29;--tx:#eef0f4;--mut:#9aa3b2;--ac:#6ea0ff;--bd:#2a3140;color-scheme:dark}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.45 system-ui,sans-serif;padding-top:env(safe-area-inset-top,0px)}
main{max-width:560px;margin:0 auto;padding:12px 12px 90px}
.c{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px;margin-bottom:12px}
h3{margin:0 0 8px;font-size:17px}
button{background:var(--card);color:var(--tx);border:1px solid var(--bd);border-radius:10px;padding:11px 14px;font:inherit;cursor:pointer}
button.p,.chip.on{background:var(--ac);color:#fff;border-color:var(--ac)}
button:disabled{opacity:.45}
input[type=text]{width:100%;box-sizing:border-box;padding:11px;border-radius:10px;border:1px solid var(--bd);background:var(--bg);color:var(--tx);font:inherit;margin-bottom:8px}
.chip{border-radius:20px;padding:6px 12px;font-size:14px;margin:0 6px 6px 0}
.row{display:flex;gap:8px;flex-wrap:wrap}
.big{font-size:32px;font-weight:700}.mut{color:var(--mut);font-size:14px}.ok{color:#16a34a}
.bar{height:8px;background:var(--bd);border-radius:6px;overflow:hidden;margin:8px 0;width:100%}.bar i{display:block;height:100%;width:0;background:var(--ac)}
.sc{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:14px}td,th{padding:6px;border-bottom:1px solid var(--bd);text-align:left;white-space:nowrap}
#feed{height:56vh;overflow-y:auto;scroll-snap-type:y mandatory;border-radius:14px;margin-bottom:8px}
.card{height:100%;box-sizing:border-box;scroll-snap-align:start;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:16px;border:2px dashed var(--bd);border-radius:14px;background:var(--card)}
.sb{display:flex;align-items:center;justify-content:center;gap:12px;width:100%;height:50px;margin-bottom:10px;border-radius:25px;font-size:16px;font-weight:600}
.sb svg{width:22px;height:22px}
.g{background:#fff;color:#1f1f1f;border:1px solid #747775}.f{background:#1877f2;color:#fff;border-color:#1877f2}
nav{position:fixed;left:0;right:0;bottom:0;display:flex;background:var(--card);border-top:1px solid var(--bd);padding-bottom:env(safe-area-inset-bottom,0px)}
nav button{flex:1;border:0;border-radius:0;background:none;padding:14px 4px;font-size:14px}
nav button.on{color:var(--ac);font-weight:700}
#lg{max-width:360px;margin:10vh auto 0}
</style>
<!--LOGINSDK-->
<link rel="preconnect" href="https://accounts.google.com"><link rel="preconnect" href="https://connect.facebook.net">
<script>
var GID='__GOOGLE_ID__',TEST=!GID||GID.indexOf('__')===0,G=null,pend=0;
function gReady(){if(TEST)return;try{G=google.accounts.oauth2.initTokenClient({client_id:GID,scope:'openid email profile',
 callback:function(r){r.access_token?window.gToken(r.access_token):window.idle&&idle('Google login fail')},
 error_callback:function(){window.idle&&idle()}});if(pend==1){pend=0;G.requestAccessToken()}}catch(e){}}
window.fbAsyncInit=function(){if(TEST)return;FB.init({appId:'__FB_ID__',version:'v21.0'});window.fbOK=1;if(pend==2){pend=0;window.fLogin&&fLogin()}};
</script>
<script src="https://accounts.google.com/gsi/client" async defer onload="gReady()"></script>
<script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_US/sdk.js"></script>
<!--ENDLOGINSDK-->
</head><body><main>
<div id="lg" class="c" style="display:none">
<h2 style="text-align:center;margin-top:0">Ads Rewards</h2>
<p class="mut" style="text-align:center">Ads dekho, coin kamao</p>
<!--DN-->
<button class="sb g" onclick="gLogin()"><svg viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>Continue with Google</button>
<button class="sb f" onclick="fLogin()"><svg viewBox="0 0 24 24" fill="#fff"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>Continue with Facebook</button>
<p id="tn" class="mut" style="display:none;text-align:center">TEST MODE: keys nahi hain, isliye button dabate hi seedha andar jaoge (nakli login). Limit 20 / 100 coin.</p><p id="m" class="mut" style="text-align:center"></p></div>
<div id="app" style="display:none"><div id="v"></div>
<nav><button data-t="a" onclick="go('a')">▶ Ads</button><button data-t="t" onclick="go('t')">📊 Tracker</button><button data-t="c" onclick="go('c')">💰 Paise</button><button id="tf" data-t="f" onclick="go('f')" style="display:none">👤 Founder</button></nav></div>
</main>
<script>
const TYPES={app:'App ads',display:'Display ads',shopping:'Shopping ads',video:'Video ads',discovery:'Discovery ads',local_services:'Local services ads'};
const LENS=[5,10,15,30,40,50,60],lab=n=>n==60?'1 minute':n+' sec';
let TOKEN=null,ME=null,tab='a',note='',active=null,io=null;
try{TOKEN=localStorage.getItem('token')}catch(e){}
const sel={t:new Set(Object.keys(TYPES)),l:new Set(LENS)};
const $=id=>document.getElementById(id),msg=t=>{$('m').textContent=t};
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const when=t=>t?new Date(t*1000).toLocaleString():'-';
const rs=c=>(c*ME.rate/100).toFixed(2);
/*API*/
function api(p,b){return TEST?mockApi(p,b):realApi(p,b)}
async function realApi(path,body){
  const o={headers:{'Content-Type':'application/json'}};
  if(TOKEN)o.headers.Authorization='Bearer '+TOKEN;
  if(body){o.method='POST';o.body=JSON.stringify(body)}
  let d={},r;try{r=await fetch(path,o);d=await r.json()}catch(e){d={error:'Network error'}}
  d._status=r?r.status:0;return d;
}
function gLogin(){if(TEST)return testIn('Google');busy();if(G)G.requestAccessToken();else pend=1}
window.gToken=t=>api('/api/login/google',{access_token:t}).then(loginDone);
function fLogin(){if(TEST)return testIn('Facebook');busy();if(!window.fbOK){pend=2;return}
  FB.login(r=>r.authResponse?api('/api/login/facebook',{access_token:r.authResponse.accessToken}).then(loginDone):idle(),{scope:'public_profile,email'})}

let TDB={users:{},seq:0,s:{rate:5,first_min:20,next_min:100}};
try{TDB=JSON.parse(localStorage.getItem('testdb'))||TDB}catch(e){}
const tsv=()=>{try{localStorage.setItem('testdb',JSON.stringify(TDB))}catch(e){}},nowS=()=>Date.now()/1000;
function testIn(p){const k='Test User ('+p+')';
  TDB.users[k]=TDB.users[k]||{name:'Test User',coins:0,md:0,upi:'',bank_acc:'',cashouts:0,last:0,views:[]};tsv();
  TOKEN=k;try{localStorage.setItem('token',k)}catch(e){}boot()}
async function mockApi(path,b){
  const u=TDB.users[TOKEN],R=(o,s=200)=>({...o,_status:s});
  if(!u)return R({error:'login'},401);
  const S=TDB.s,need=u.cashouts?S.next_min:S.first_min,dn=()=>u.views.filter(v=>v.ok);
  if(path==='/api/me')return R({name:u.name,coins:u.coins,is_admin:false,rate:S.rate,method_done:u.md,upi:u.upi,bank_acc:u.bank_acc,cashouts:u.cashouts,need});
  if(path==='/api/payout-method'){if(!b.skip){if(!b.upi&&!b.bank_acc)return R({error:'UPI ya bank dalo, ya Skip dabao'},400);u.upi=b.upi;u.bank_acc=b.bank_acc}u.md=1;tsv();return R({ok:1})}
  if(path==='/api/ad/start'){const id=++TDB.seq,v={id,type:b.type,length:b.length,title:TYPES[b.type]+' #'+(100+id%900),started:nowS(),ok:0};u.views.push(v);tsv();return R({view_id:id,title:v.title})}
  if(path==='/api/ad/complete'){const v=u.views.find(x=>x.id==b.view_id);if(!v||v.ok)return R({error:'invalid'},400);
    if(nowS()-Math.max(v.started,u.last)<v.length)return R({error:'Ad poora nahi dekha'},400);
    v.ok=1;v.done=nowS();u.last=v.done;const e=v.length/5;u.coins+=e;tsv();return R({coins:u.coins,earned:e})}
  if(path==='/api/tracker'){const d=dn(),bt={};d.forEach(v=>bt[v.type]=(bt[v.type]||0)+1);
    return R({ads:d.slice().reverse().map(v=>({title:v.title,ad_type:v.type,length:v.length,done:v.done})),total:d.length,secs:d.reduce((a,v)=>a+v.length,0),by_type:Object.entries(bt).map(([ad_type,n])=>({ad_type,n}))})}
  if(path==='/api/cashout'){if(u.coins<need)return R({error:'Kam se kam '+need+' coin chahiye'},400);u.coins=0;u.cashouts++;u.views=[];tsv();return R({ok:1})}
  return R({error:'test mode ma ye nahi ha'},404)}
/*ENDAPI*/
let bt=0;function busy(){document.querySelectorAll('.sb').forEach(b=>b.disabled=true);msg('Login ho raha ha...');clearTimeout(bt);bt=setTimeout(()=>{if(!TOKEN)idle('Login poora nahi hua. Dobara dabao.')},20000)}
function idle(t){document.querySelectorAll('.sb').forEach(b=>b.disabled=false);msg(t||'')}
function loginDone(d){if(d.token){TOKEN=d.token;try{localStorage.setItem('token',TOKEN)}catch(e){}boot()}else idle(d.error||'Login fail')}
function logout(){try{localStorage.removeItem('token')}catch(e){}TOKEN=null;active=null;boot()}
async function boot(){
  if(!TOKEN){$('app').style.display='none';$('lg').style.display='block';$('tn').style.display=TEST?'block':'none';idle();return}
  ME=await api('/api/me');
  if(ME._status===401)return logout();
  $('lg').style.display='none';$('app').style.display='block';
  const tf=$('tf');if(tf)tf.style.display=ME.is_admin?'':'none';
  render();
}
const V={a:homeView,t:trackerView,c:cashView};
async function render(){
  active=null;
  document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('on',b.dataset.t===tab));
  $('v').innerHTML=await V[tab]();
  if(tab==='a')initFeed();
}
function go(t){tab=t;note='';render()}
async function refresh(){ME=await api('/api/me');render()}
/* ---------- ADS (scroll feed) ---------- */
const chip=(k,v,t)=>`<button class="chip ${sel[k].has(v)?'on':''}" onclick="tog('${k}','${v}',this)">${t}</button>`;
function tog(k,v,el){const x=k==='l'?+v:v,s=sel[k];s.has(x)?s.delete(x):s.add(x);el.classList.toggle('on')}
function homeView(){
  return `${ME.method_done?'':payForm(true)}
<div class="c"><div class="mut">${esc(ME.name)}</div><div class="big"><span id="coins">${ME.coins}</span> coin</div>
<div class="mut">Coin se kuch kharid nahi sakte. Sirf paise nikalne ke liye.</div></div>
<details class="c"><summary><b>Ad ka type aur time choose karo</b></summary>
<p class="mut">Type</p>${Object.entries(TYPES).map(([k,t])=>chip('t',k,t)).join('')}
<p class="mut">Ad kitna lamba</p>${LENS.map(n=>chip('l',n,lab(n)+' = '+n/5+' coin')).join('')}</details>
<div id="feed"></div><button class="p" style="width:100%;margin:6px 0" onclick="nextAd()">Agla ad ⬇</button><p class="mut" style="text-align:center">Ya neeche scroll karo</p>`;
}
function initFeed(){
  io=new IntersectionObserver(es=>es.forEach(e=>{
    if(e.isIntersecting){active=e.target;if(!e.target.nextElementSibling)addCard()}
  }),{root:$('feed'),threshold:0.6});
  $('feed').innerHTML='<p class="mut ph" style="padding:20px">Ad load ho raha ha...</p>';
  addCard();
}
async function addCard(){
  const ts=[...sel.t],ls=[...sel.l],f=$('feed'),me=io;
  if(!f||!me)return;
  if(!ts.length||!ls.length){if(!f.querySelector('.card'))f.innerHTML='<p class="mut ph" style="padding:20px">Kam se kam ek type aur ek time choose karo</p>';return}
  if(me._busy)return;me._busy=1;
  const type=ts[Math.random()*ts.length|0],len=ls[Math.random()*ls.length|0];
  const s=await api('/api/ad/start',{type,length:len});me._busy=0;
  if($('feed')!==f||io!==me)return;
  if(!s.view_id){if(!f.querySelector('.card'))f.innerHTML='<p class="mut ph" style="padding:20px">Ad nahi aa paya, dobara try ho raha ha...</p>';return}
  const c=document.createElement('div');c.className='card';c.dataset.vid=s.view_id;c.dataset.len=len;
  c.innerHTML=`<small class="mut">${TYPES[type]}</small><h3>${esc(s.title)}</h3><p class="mut">Yaha asli ad aayega</p><div class="bar"><i></i></div><b class="tm">${len} sec</b><div class="st mut">+${len/5} coin milega</div>`;
  f.querySelectorAll('.ph').forEach(x=>x.remove());
  f.appendChild(c);me.observe(c);
}
async function tick(){
  const c=active;if(!c||c.dataset.done||c.dataset.busy||document.visibilityState!=='visible')return;
  c._el=(c._el||0)+.25;const n=+c.dataset.len;
  c.querySelector('i').style.width=Math.min(100,c._el/n*100)+'%';
  c.querySelector('.tm').textContent=Math.max(0,Math.ceil(n-c._el))+' sec baki';
  if(c._el>=n){
    c.dataset.busy=1;const r=await api('/api/ad/complete',{view_id:c.dataset.vid});
    c.dataset.busy='';c.dataset.done=1;const st=c.querySelector('.st');
    if(r.earned){ME.coins=r.coins;$('coins')&&($('coins').textContent=r.coins);st.textContent='✓ +'+r.earned+' coin mila! Neeche scroll karo ⬇';st.className='st ok'}
    else st.textContent=r.error||'Error';
  }
}
setInterval(tick,250);
setInterval(()=>{const f=$('feed');if(!f||!io||io._busy)return;const l=f.lastElementChild;   // hamesha ek ad aage tayyar rakho, fail ho to dobara try
  if(!l||!l.classList.contains('card')||l===active||l.dataset.done)addCard()},1000);
function nextAd(){const f=$('feed');if(f)f.scrollBy({top:f.clientHeight,behavior:'smooth'})}
/* ---------- TRACKER ---------- */
async function trackerView(){
  const t=await api('/api/tracker');
  const bt=(t.by_type||[]).map(x=>`${TYPES[x.ad_type]||x.ad_type}: ${x.n}`).join(' • ')||'-';
  return `<div class="c"><h3>Tumhara tracker</h3><p>Total ads: <b>${t.total||0}</b> • Total time: <b>${t.secs||0} sec</b></p><p class="mut">${esc(bt)}</p></div>
<div class="c sc"><h3>Kaun kaun sa ads dekha</h3>${(t.ads||[]).length?`<table><tr><th>Ad</th><th>Time</th><th>Kab</th></tr>${t.ads.map(a=>`<tr><td>${esc(a.title)}</td><td>${a.length} sec</td><td>${when(a.done)}</td></tr>`).join('')}</table>`:'<p class="mut">Abhi koi ad nahi dekha</p>'}</div>`;
}
/* ---------- PAISE (cash-out) ---------- */
function payForm(first){
  const has=ME.upi||ME.bank_acc;
  return `<div class="c"><h3>Paise kaise lene ha?</h3>
${has&&!first?`<p>${ME.upi?'Google Pay / UPI: <b>'+esc(ME.upi)+'</b>':'Bank: <b>****'+esc(ME.bank_acc.slice(-4))+'</b>'}</p>`:''}
<input type="text" id="upi" placeholder="Google Pay / UPI ID (name@okhdfcbank)" value="${esc(ME.upi)}">
<details><summary class="mut">Ya bank account dalo</summary><input type="text" id="ba" inputmode="numeric" placeholder="Bank account number"><input type="text" id="ifsc" placeholder="IFSC code"></details>
<div class="row"><button class="p" onclick="savePay()">Save</button><button onclick="skipPay()">Skip</button></div>
<p class="mut">Ye zaruri nahi ha. Skip karne par bhi coin kama sakte ho.</p><p class="ok">${esc(note)}</p></div>`;
}
async function savePay(){
  const r=await api('/api/payout-method',{upi:$('upi').value.trim(),bank_acc:$('ba').value.trim(),ifsc:$('ifsc').value.trim().toUpperCase()});
  note=r.ok?'Save ho gaya':(r.error||'Error');refresh();
}
async function skipPay(){await api('/api/payout-method',{skip:true});refresh()}
async function cashout(){const r=await api('/api/cashout',{});note=r.ok?'Message gaya. Founder jald paise bhejega.':(r.error||'Error');refresh()}
function cashView(){
  const ok=ME.coins>=ME.need;
  return `<div class="c"><div class="big">${ME.coins} coin</div><div>= ₹${rs(ME.coins)}</div>
<p class="mut">${ME.cashouts?'Agli baar':'Pehli baar'} paise nikalne ke liye kam se kam <b>${ME.need} coin</b> (₹${rs(ME.need)}) chahiye.</p>
${ok?'':`<div class="bar"><i style="width:${Math.min(100,ME.coins/ME.need*100)}%"></i></div><p class="mut">Abhi ${ME.need-ME.coins} coin aur chahiye.</p>`}
<button class="p" style="width:100%" ${ok?'':'disabled'} onclick="cashout()">Founder ko message bhejo</button>
<p class="mut">Message bhejne par tumhare coin aur tracker data tumhare account se hat kar founder ke paas jayenge. Founder paise offline bhejega.</p><p class="ok">${esc(note)}</p></div>${payForm(false)}<button onclick="logout()">Logout</button>`;
}
/*FOUNDER*/
async function founderView(){
  const [s,p]=await Promise.all([api('/api/admin/summary'),api('/api/admin/payouts')]);
  if(!s.users)return '<div class="c">Ye account founder nahi ha (ADMIN_EMAILS ma email dalo).</div>';
  const bt={};s.by_type.forEach(t=>{(bt[t.user_id]=bt[t.user_id]||[]).push((TYPES[t.ad_type]||t.ad_type)+': '+t.n)});
  const st=s.settings;
  return `<div class="c"><h3>Settings</h3>
<label>1 coin = <select id="sr"><option ${st.rate==5?'selected':''}>5</option><option ${st.rate==10?'selected':''}>10</option></select> paise</label>
<p class="mut">Pehli baar kam se kam coin</p><input type="text" id="s1" inputmode="numeric" value="${st.first_min}">
<p class="mut">Agli baar kam se kam coin</p><input type="text" id="s2" inputmode="numeric" value="${st.next_min}">
<button class="p" onclick="saveSet()">Save</button> <span class="ok">${esc(note)}</span></div>
<div class="c sc"><h3>Users ka tracker</h3><table><tr><th>User</th><th>Ads</th><th>Sec</th><th>Coin</th><th>₹</th><th>Cash-out</th></tr>
${s.users.map(u=>`<tr><td>${esc(u.name||u.email)}<br><span class="mut">${esc((bt[u.id]||[]).join(', '))}</span></td><td>${u.ads}</td><td>${u.secs}</td><td>${u.coins}</td><td>${u.rupees.toFixed(2)}</td><td>${u.cashouts}</td></tr>`).join('')}</table></div>
<div class="c sc"><h3>Kisna kya dekha (last 30)</h3><table><tr><th>Kaun</th><th>Ad</th><th>Sec</th><th>Kab</th></tr>
${s.recent.map(r=>`<tr><td>${esc(r.name)}</td><td>${esc(r.title)}</td><td>${r.length}</td><td>${when(r.done)}</td></tr>`).join('')}</table></div>
<div class="c"><h3>Paise ke messages</h3>${p.payouts.length?p.payouts.map(x=>`<div style="border-top:1px solid var(--bd);padding:8px 0">
<b>${esc(x.name)}</b>: ${x.coins} coin = ₹${(x.paise/100).toFixed(2)} <span class="mut">${when(x.created)}</span><br>
<span class="mut">${x.upi?'UPI: '+esc(x.upi):''} ${x.bank_acc?'Bank: '+esc(x.bank_acc)+' / '+esc(x.ifsc):''} ${x.upi||x.bank_acc?'':'Payment detail nahi di (offline)'}</span><br>
${x.paid?'<span class="ok">Paid</span>':`<button onclick="paid(${x.id})">Paid kiya</button>`}
<details><summary class="mut">Tracker data (${x.snapshot.length} ads)</summary>${x.snapshot.map(a=>`<div class="mut">${esc(a.title)} • ${a.length} sec • ${when(a.done)}</div>`).join('')}</details></div>`).join(''):'<p class="mut">Koi nahi</p>'}</div>`;
}
V.f=founderView;
async function saveSet(){const r=await api('/api/admin/settings',{rate:+$('sr').value,first_min:+$('s1').value,next_min:+$('s2').value});note=r.ok?'Save ho gaya':(r.error||'Error');render()}
async function paid(id){await api('/api/admin/payout-paid',{id});render()}
/*ENDFOUNDER*/
boot();
</script></body></html>
